/* 档案详情页 */

.file-head {
  display: flex;
  align-items: center;
}

.file-head .tag {
  margin-left: 16rpx;
}

.d-title {
  margin-top: 16rpx;
  font-size: 56rpx;
  line-height: 1.4;
  font-weight: bold;
  color: #1F1F1D;
}

.d-scale {
  margin-top: 20rpx;
}

.d-claim-card {
  position: relative;
}

.d-claim-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.d-sec-label {
  font-size: 24rpx;
  letter-spacing: 6rpx;
  color: #8A857C;
}

.d-label-red {
  color: #C33A2E;
}

.d-claim {
  margin-top: 16rpx;
  font-size: 32rpx;
  color: #1F1F1D;
}

/* 真相卡：默认暗色未翻开，翻开后为墨底亮字 */
.d-truth-card {
  margin-top: 20rpx;
  background: #1F1F1D;
  border-color: #1F1F1D;
  min-height: 200rpx;
  transition: min-height 320ms ease-out;
}

.d-flip-hint {
  display: block;
  margin-top: 24rpx;
  font-size: 26rpx;
  letter-spacing: 2rpx;
  color: rgba(247, 243, 234, 0.6);
}

.d-truth-card .d-sec-label {
  color: #E4A199;
}

.d-truth {
  margin-top: 16rpx;
  font-size: 32rpx;
  color: #F7F3EA;
}

.d-quote {
  margin-top: 20rpx;
  font-size: 28rpx;
  font-style: italic;
  color: rgba(247, 243, 234, 0.75);
}

/* 为什么错 */
.d-why {
  display: flex;
  margin-top: 20rpx;
}

.d-why-no {
  font-size: 26rpx;
  color: #C33A2E;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.d-why-text {
  flex: 1;
  font-size: 28rpx;
  color: #1F1F1D;
}

.d-cond {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #1F1F1D;
}

.d-source {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #1F1F1D;
}

.d-disclaim {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #8A857C;
}

/* 操作 */
.d-actions {
  display: flex;
  margin-top: 32rpx;
}

.d-btn {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  letter-spacing: 4rpx;
  color: #1F1F1D;
  border: 1rpx solid #D9D2C3;
  border-radius: 12rpx;
  padding: 18rpx 0;
  margin: 0;
  background: transparent;
}

.d-btn + .d-btn {
  margin-left: 24rpx;
}

.d-btn-share {
  color: #C33A2E;
  border-color: rgba(195, 58, 46, 0.5);
  line-height: inherit;
}

.d-btn-share::after {
  border: none;
}

/* 相关误区 */
.d-rel-item {
  margin-bottom: 20rpx;
}

.d-rel-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.d-rel-title {
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: bold;
  color: #1F1F1D;
}

.empty-back {
  display: inline-block;
  margin-top: 24rpx;
  color: #C33A2E;
  border-bottom: 1rpx solid rgba(195, 58, 46, 0.4);
}
