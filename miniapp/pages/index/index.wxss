/* 首页 · 今日反转 */

.masthead {
  padding: 16rpx 0 8rpx;
  display: flex;
  flex-direction: column;
}

.mast-date {
  font-size: 24rpx;
  color: #8A857C;
  letter-spacing: 2rpx;
}

.mast-title {
  font-size: 64rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
  color: #1F1F1D;
  margin-top: 8rpx;
}

.mast-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8A857C;
  letter-spacing: 2rpx;
}

.card-links {
  margin-top: 20rpx;
  text-align: center;
}

.link {
  font-size: 26rpx;
  color: #C33A2E;
  letter-spacing: 2rpx;
  border-bottom: 1rpx solid rgba(195, 58, 46, 0.4);
  padding-bottom: 4rpx;
}

.sec-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin: 48rpx 0 20rpx;
}

.sec-head .sec-title {
  margin-bottom: 0;
}

.sec-more {
  font-size: 24rpx;
  color: #8A857C;
}

/* 三连问 */
.qa-item {
  margin-bottom: 20rpx;
}

.qa-no {
  font-size: 24rpx;
  color: #8A857C;
}

.qa-label {
  margin-top: 12rpx;
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: #8A857C;
}

.qa-question {
  margin-top: 6rpx;
  font-size: 32rpx;
  color: #1F1F1D;
}

.qa-btns {
  display: flex;
  margin-top: 28rpx;
}

.qa-btn {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  letter-spacing: 4rpx;
  color: #1F1F1D;
  border: 1rpx solid #D9D2C3;
  border-radius: 12rpx;
  padding: 16rpx 0;
}

.qa-btn + .qa-btn {
  margin-left: 24rpx;
}

.qa-btn-red {
  color: #C33A2E;
  border-color: rgba(195, 58, 46, 0.5);
}

.qa-tip {
  margin-top: 14rpx;
  text-align: center;
  font-size: 22rpx;
  color: #8A857C;
}

.qa-verdict {
  margin-top: 24rpx;
  font-size: 28rpx;
  letter-spacing: 2rpx;
}

.qa-verdict.ok {
  color: #1F1F1D;
}

.qa-verdict.no {
  color: #C33A2E;
}

.qa-answer {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: #1F1F1D;
}

.qa-source {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #8A857C;
}

/* 最近收录 */
.recent-item {
  margin-bottom: 20rpx;
}

.recent-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.recent-title {
  margin-top: 12rpx;
  font-size: 40rpx;
  font-weight: bold;
  color: #1F1F1D;
}

.recent-claim {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: #8A857C;
}

.recent-item .scale {
  margin-top: 20rpx;
}

/* 拆弹入口 */
.quiz-entry {
  margin-top: 48rpx;
  position: relative;
  padding: 40rpx 32rpx;
}

.quiz-entry-title {
  font-size: 44rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
}

.quiz-entry-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #8A857C;
}

.quiz-entry-go {
  position: absolute;
  right: 32rpx;
  bottom: 40rpx;
  font-size: 26rpx;
  color: #C33A2E;
  border: 1rpx solid rgba(195, 58, 46, 0.5);
  border-radius: 10rpx;
  padding: 8rpx 24rpx;
}
